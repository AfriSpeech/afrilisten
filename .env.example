# This service mints short-lived Gemini Live tokens; it never handles page
# text or audio. The browser uses the token to open a Gemini Live session
# directly and speaks the page itself. See README.md and DEPLOY.md.

# Gemini. A free-tier key from https://aistudio.google.com/apikey works --
# no billing account required -- but is metered more tightly than a paid one,
# which is what LISTEN_RATE_* and LISTEN_BUDGET_PER_DAY below are for. It is a
# secret, never committed, and never anything in browser code -- only the
# short-lived tokens minted from it ever reach a browser.
GEMINI_API_KEY=

# The one model and voice, locked into every token minted.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Zephyr

# How much of the page the widget reads, and how big a piece it splits that
# into for one Gemini Live turn. Sent to the browser over /languages.
LISTEN_MAX_CHARS=1000
LISTEN_TTS_CHUNK_CHARS=250

# How many Live sessions a minted token is good for: sized per piece, with
# headroom for one retry each, then clamped to this floor and ceiling.
LISTEN_TOKEN_USES_PER_PIECE=2
LISTEN_TOKEN_MIN_USES=4
LISTEN_TOKEN_MAX_USES=40
# How long a token may be used to send messages, and how long the browser has
# to start its Live sessions with it.
LISTEN_TOKEN_EXPIRE_MINUTES=10
LISTEN_TOKEN_NEW_SESSION_MINUTES=2

# Shared secret the website sends as x-listen-key. Without it the endpoint is
# closed, so your Gemini quota cannot be spent by anyone who finds the URL.
LISTEN_API_KEY=

# Origins allowed to call the endpoint, comma separated.
LISTEN_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# What a caller may cost: these bound how many tokens -- and so how many
# Gemini Live sessions -- can be minted.
LISTEN_RATE_PER_MINUTE=5
LISTEN_RATE_PER_DAY=100
LISTEN_BUDGET_PER_DAY=5000

PORT=8787
HOST=0.0.0.0
